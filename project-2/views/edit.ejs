<!DOCTYPE html>
<html>
<head><title>Edit Member</title></head>
<body>
    <h1>Edit Member</h1>

    <% if (errors && errors.length > 0) { %>
        <ul style="color: red;">
        <% errors.forEach(error => { %>
            <li><%= error %></li>
        <% }) %>
        </ul>
    <% } %>

    <form action="/member/edit/<%= member._id %>" method="POST">
        <label>Name:</label>
        <input type="text" name="name" value="<%= member.name %>" required><br>

        <label>Age:</label>
        <input type="number" name="age" value="<%= member.age %>" required><br>

        <label>University:</label>
        <input type="text" name="university" value="<%= member.university %>" required><br>

        <label>Email:</label>
        <input type="email" name="email" value="<%= member.email %>" required><br>

        <label>Phone:</label>
        <input type="text" name="phone" value="<%= member.phone %>" required><br>

        <label>Technical Committee:</label>
        <input type="text" name="technicalCommittee" value="<%= member.technicalCommittee %>"><br>

        <label>Non-Technical Committee:</label>
        <input type="text" name="nonTechnicalCommittee" value="<%= member.nonTechnicalCommittee %>"><br>

        <label>Image URL:</label>
        <input type="text" name="imageUrl" value="<%= member.imageUrl %>"><br>

        <button type="submit">Update Member</button>
    </form>

    <p><a href="/members">Back to Member Page</a></p>
</body>
</html>
